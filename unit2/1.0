#include <stdio.h>
int main()
{
int a = 10, b = 5, c = 2;
int result;
result = a + b * c;
printf("Expression: a + b * c\n");
printf("a = %d, b = %d, c = %d\n", a, b, c);
printf("Result = %d\n", result);
return 0;
}
Output
Expression: a + b * c
a = 10, b = 5, c = 2
Result = 20
Explanation: Multiplication * has higher precedence than
addition +, so b * c is evaluated first.